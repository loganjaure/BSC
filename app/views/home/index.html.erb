<%# AC-05.2: never show a cached copy of this page, so the point total is fresh after checking in %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<% if logged_in? %>
  <section class="bsc-center">
    <% if current_member.nil? %>
      <div class="bsc-panel bsc-panel--narrow">
        <p>Your member profile hasn't been created yet. Contact a BSC officer to get set up.</p>
      </div>
    <% else %>
      <%# AC-05.1 / AC-05.3: member's name and current points (shown per category below) %>
      <h1 class="bsc-title"><%= current_member.name.presence || current_user.full_name %></h1>

      <%# AC-05.1 / AC-05.3: current points, 0 for a new member %>
      <%# AC-16:01: points earned per category this semester, side by side and horizontally scrollable %>
      <% if @current_semester.nil? %>
        <p class="bsc-sub">No active semester. Category progress will show here once a semester is set up.</p>
      <% elsif @category_progress.empty? %>
        <p class="bsc-sub">No categories have been set up yet.</p>
      <% else %>
        <ul class="bsc-progress-list" aria-label="Category progress">
          <%= render partial: "home/category_progress", collection: @category_progress, as: :row %>
        </ul>
      <% end %>

      <%# AC-05.6: event list showing which events are active %>
      <h2 class="bsc-section-title">Events</h2>
      <% if @events.empty? %>
        <p class="bsc-sub">No events have been added yet.</p>
      <% else %>
        <div class="bsc-event-list">
          <% @events.each do |event| %>
            <%= render "home/event_card", event: event, checked_in: @checked_in_ids.include?(event.id) %>
          <% end %>
        </div>
      <% end %>

      <%# AC-05.4: Appeals section is visible but not interactive yet %>
      <div class="bsc-appeals-preview" aria-disabled="true">
        <h2 class="bsc-section-title">Appeals</h2>
        <p>Submitting appeals isn't available yet.</p>
      </div>
    <% end %>
  </section>
<% else %>
  <section class="bsc-center bsc-signin">
    <%# AC-22.02: BSC logo on the sign-in page %>
    <div class="bsc-signin__brand">
      <%= image_tag "bsc-logo.png", alt: "Business Student Council, Texas A&M University", class: "bsc-logo" %>
    </div>
    <h1 class="bsc-title">BSC Attendance Portal</h1>
    <p class="bsc-sub">Sign in with your official TAMU email (@tamu.edu).</p>
    <%= button_to "Sign in with Google", "/auth/google_oauth2",
          method: :post, data: { turbo: false }, class: "bsc-btn bsc-btn--lg" %>
    <%# AC-23.1: help is reachable before signing in %>
    <%= link_to "Need help?", support_path, class: "bsc-back" %>
  </section>
<% end %>