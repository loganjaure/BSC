<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Bsc 500" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%# AC-22.01: browser theme color matches the BSC navy %>
    <meta name="theme-color" content="#0b2545">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <%# Includes all stylesheet files in app/assets/stylesheets (bsc_theme.css included) %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bsc-body" data-controller="glow">
    <% if logged_in? %>
      <%# AC-22.01: navy BSC header %>
      <header class="bsc-header">
        <div class="bsc-header__inner">
          <%# AC-22.02: BSC logo in the header %>
          <%= image_tag "bsc-logo.png", alt: "Business Student Council, Texas A&M University", class: "bsc-logo" %>
          <%= render "shared/nav" %>
        </div>
      </header>
    <% end %>

    <main class="bsc-page">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <%# AC-22.01: navy BSC footer with the council's pillars %>
    <footer class="bsc-footer">
      <p class="bsc-footer__pillars">Leadership <span aria-hidden="true">|</span> Integrity <span aria-hidden="true">|</span> Excellence <span aria-hidden="true">|</span> Service</p>
      <p>Business Student Council &middot; Texas A&amp;M University</p>
    </footer>
  </body>
</html>
