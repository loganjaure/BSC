<div class="container mt-4">
  <h2><%= @event.new_record? ? "Create New Event" : "Edit Event" %></h2>

  <% if @event.errors.any? %>
    <div class="alert alert-danger">
      <h4>
        <%= pluralize(@event.errors.count, "error") %>
        prohibited this event from being saved:
      </h4>
      <ul>
        <% @event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with(model: [:admin, @event], local: true) do |f| %>
    <div class="mb-3">
      <%= f.label :event_name, "Event Name", class: "form-label" %>
      <%= f.text_field :event_name, class: "form-control", required: true %>
    </div>

    <div class="mb-3">
      <%= f.label :semester_id, "Semester", class: "form-label" %>
      <%= f.collection_select :semester_id, @semesters, :id, :term_name,
          { prompt: "Select Semester" }, { class: "form-select", required: true } %>
    </div>

    <div class="mb-3">
      <%= f.label :category_id, "Category", class: "form-label" %>
      <%= f.collection_select :category_id, @categories, :id, :category_name,
          { prompt: "Select Category" }, { class: "form-select", required: true } %>
    </div>

    <div class="mb-3">
      <%= f.label :event_date_time, "Date and Time", class: "form-label" %>
      <%= f.datetime_local_field :event_date_time,
          value: (@event.event_date_time&.strftime("%Y-%m-%dT%H:%M")),
          class: "form-control", required: true %>
    </div>

    <div class="mb-3">
      <%= f.label :description, "Description", class: "form-label" %>
      <%= f.text_area :description, rows: 4,
          class: "form-control", required: true %>
    </div>

    <div class="mb-3">
      <%= f.label :point_value, "Point Value", class: "form-label" %>
      <%= f.number_field :point_value, min: 0, step: 1,
          class: "form-control", required: true %>
    </div>

    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_events_path,
        class: "btn btn-secondary ms-2" %>
  <% end %>
</div>
