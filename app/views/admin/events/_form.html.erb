<div class="container mt-4">
  <h2><%= @event.new_record? ? "Create New Event" : "Edit Event" %></h2>

  <% if @event.errors.any? %>
    <div class="alert alert-danger">
      <h4>
        <%= pluralize(@event.errors.count, "error") %>
        prohibited this event from being saved:
      </h4>
      <ul>
        <% @event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with(model: [:admin, @event], local: true) do |f| %>
    <div class="mb-3">
      <%= f.label :event_name, "Event Name", class: "form-label" %>
      <%= f.text_field :event_name, class: "form-control", required: true %>
    </div>

    <div class="mb-3">
      <%= f.label :semester_id, "Semester", class: "form-label" %>
      <%= f.collection_select :semester_id, @semesters, :id, :term_name,
          { prompt: "Select Semester" }, { class: "form-select", required: true } %>
    </div>

    <div class="mb-3">
      <%= f.label :category_id, "Category", class: "form-label" %>
      <%= f.collection_select :category_id, @categories, :id, :category_name,
          { prompt: "Select Category" }, { class: "form-select", required: true } %>
    </div>

    <div class="mb-3">
      <%= f.label :event_date_time, "Date and Time", class: "form-label" %>
      <%= f.datetime_local_field :event_date_time,
          value: (@event.event_date_time&.strftime("%Y-%m-%dT%H:%M")),
          class: "form-control", required: true %>
    </div>

    <div class="mb-3">
      <%= f.label :description, "Description", class: "form-label" %>
      <%= f.text_area :description, rows: 4,
          class: "form-control", required: true %>
    </div>

    <div class="mb-3">
      <%= f.label :point_value, "Point Value", class: "form-label" %>
      <%= f.number_field :point_value, min: 0, step: 1,
          class: "form-control", required: true %>
    </div>
    
    <div class="mb-3">
      <%= f.label :check_in_code, "Check-in Code (Optional)", class: "form-label" %>

      <%= f.text_field :check_in_code,
          class: "form-control",
          placeholder: "Leave blank if no code is required",
          autocomplete: "off" %>

      <div class="form-text">
        If a code is entered, members must provide it to check in to this event.
      </div>
    </div>


    <hr class="my-4">

    <h4>Check-in Time Settings</h4>
    <p class="text-muted">
      Customize when members are allowed to check in for this event.
      The defaults are 15 minutes before and 60 minutes after the event starts.
    </p>

    <div class="row">
      <div class="col-md-6 mb-3">
        <%= f.label :check_in_opens_minutes_before,
            "Open Check-in (Minutes Before Event)", class: "form-label" %>

        <%= f.number_field :check_in_opens_minutes_before,
            min: 0, step: 1, class: "form-control", required: true %>

        <div class="form-text">
          Example: 15 means check-in opens 15 minutes before the event.
        </div>
      </div>

      <div class="col-md-6 mb-3">
        <%= f.label :check_in_closes_minutes_after,
            "Close Check-in (Minutes After Event)", class: "form-label" %>

        <%= f.number_field :check_in_closes_minutes_after,
            min: 0, step: 1, class: "form-control", required: true %>

        <div class="form-text">
          Example: 60 means check-in closes 1 hour after the event starts.
        </div>
      </div>
    </div>


    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_events_path,
        class: "btn btn-secondary ms-2" %>
  <% end %>
</div>
