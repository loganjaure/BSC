<div class="container mt-4">
  <h2>Create New Event</h2>

  <%# AC-13.03: Display errors if validation fails %>
  <% if @event.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(@event.errors.count, "error") %> prohibited this event from being saved:</h4>
      <ul>
        <% @event.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with(model: @event, url: admin_events_path, local: true) do |f| %>
    <div class="mb-3">
      <%= f.label :event_name, "Event Name", class: "form-label" %>
      <%= f.text_field :event_name, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= f.label :semester_id, "Semester", class: "form-label" %>
      <%= f.collection_select :semester_id, Semester.all, :id, :term_name, { prompt: "Select Semester" }, { class: "form-select" } %>
    </div>

    <div class="mb-3">
      <%= f.label :category_id, "Category", class: "form-label" %>
      <%= f.collection_select :category_id, Category.all, :id, :category_name, { prompt: "Select Category" }, { class: "form-select" } %>
    </div>

    <div class="mb-3">
      <%= f.label :event_date_time, "Date and Time", class: "form-label" %>
      <%= f.datetime_local_field :event_date_time, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= f.label :description, "Description", class: "form-label" %>
      <%= f.text_area :description, rows: 4, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= f.label :point_value, "Point Value", class: "form-label" %>
      <%= f.number_field :point_value, value: @event.point_value || 1, min: 0, step: 1, class: "form-control" %>
    </div>

    <%= f.submit "Create Event", class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_events_path, class: "btn btn-secondary ms-2" %>
  <% end %>
</div>
