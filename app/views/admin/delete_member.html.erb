<section class="bsc-center">
  <h1 class="bsc-title">Delete Member from Roster</h1>

  <div class="bsc-panel">
    <h2><%= @member.name %></h2>
    <p><strong>TAMU email:</strong> <%= @member.tamu_email %></p>
    <p><strong>UIN:</strong> <%= @member.uin.presence || "Not provided" %></p>

    <% if @deletion_blocker %>
      <p role="alert"><%= @deletion_blocker %></p>
    <% else %>
      <p>This archives the member and removes them from the active roster. Their profile, points, attendance, and appeals are retained.</p>
      <p>Their current application sessions and future sign-ins will be blocked. Their Google account is unaffected.</p>

      <%= form_with url: admin_member_path(@member), method: :delete, local: true do |form| %>
        <p>
          <%= check_box_tag :confirm_delete, "1", false, required: true %>
          <%= label_tag :confirm_delete, "I confirm that this member should be removed from the active roster and their application access disabled." %>
        </p>
        <%= form.submit "Archive Member" %>
      <% end %>
    <% end %>

    <%= link_to "Cancel", admin_member_path(@member) %>
    <%= link_to "Back to Admin", admin_path %>
  </div>
</section>
