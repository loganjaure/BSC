<section class="bsc-center">
  <h1 class="bsc-title">Delete Member</h1>

  <div class="bsc-panel">
    <h2><%= @member.name %></h2>
    <p><strong>TAMU email:</strong> <%= @member.tamu_email %></p>
    <p><strong>UIN:</strong> <%= @member.uin.presence || "Not provided" %></p>

    <% if @deletion_blocker %>
      <p role="alert"><%= @deletion_blocker %></p>
    <% else %>
      <p>This permanently deletes this member and their linked application login account. It cannot be undone.</p>
      <p>Members with attendance or appeal history cannot be deleted. This does not delete the person's Google account or ban future registration.</p>

      <%= form_with url: admin_member_path(@member), method: :delete, local: true do |form| %>
        <p>
          <%= check_box_tag :confirm_delete, "1", false, required: true %>
          <%= label_tag :confirm_delete, "I understand that this member and their application login account will be permanently deleted." %>
        </p>
        <%= form.submit "Permanently Delete Member" %>
      <% end %>
    <% end %>

    <%= link_to "Cancel", admin_member_path(@member) %>
    <%= link_to "Back to Admin", admin_path %>
  </div>
</section>
