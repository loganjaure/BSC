<% if category.errors.any? %>
  <div class="alert alert-danger">
    <ul class="mb-0">
      <% category.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with(model: [:admin, category]) do |f| %>
  <div class="mb-3">
    <%= f.label :category_name, "Category Name", class: "form-label" %>
    <%= f.text_field :category_name, class: "form-control", required: true %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", admin_categories_path,
              class: "btn btn-secondary ms-2" %>
<% end %>
