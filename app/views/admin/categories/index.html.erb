
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Event Categories</h2>
    <%= link_to "New Category", new_admin_category_path,
                class: "btn btn-primary" %>
  </div>

  <% if notice.present? %>
    <div class="alert alert-success"><%= notice %></div>
  <% end %>

  <% if alert.present? %>
    <div class="alert alert-danger"><%= alert %></div>
  <% end %>

  <table class="table table-striped">
    <thead>
      <tr>
        <th>Category</th>
        <th>Events</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% @categories.each do |category| %>
        <tr>
          <td><%= category.category_name %></td>

          <td><%= category.events.count %></td>

          <td>
            <%= link_to "Edit", edit_admin_category_path(category),
                        class: "btn btn-sm btn-outline-primary" %>

            <%= form_with url: admin_category_path(category),
                          method: :delete,
                          local: true,
                          class: "d-inline-flex align-items-center gap-2" do %>

              <% if category.events.exists? %>
                <%= select_tag :replacement_category_id,
                    options_from_collection_for_select(
                      @categories.reject { |c| c.id == category.id },
                      :id,
                      :category_name
                    ),
                    prompt: "Move events to...",
                    class: "form-select form-select-sm",
                    required: true %>
              <% end %>

              <%= submit_tag "Delete",
                  class: "btn btn-sm btn-outline-danger",
                  data: {
                    turbo_confirm: "Delete this category? Existing events will be moved to the selected category."
                  } %>

            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
