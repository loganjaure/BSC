<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Event Categories</h2>
    <%= link_to "New Category", new_admin_category_path,
                class: "btn btn-primary" %>
  </div>

  <% if notice.present? %>
    <div class="alert alert-success"><%= notice %></div>
  <% end %>

  <% if alert.present? %>
    <div class="alert alert-danger"><%= alert %></div>
  <% end %>

  <table class="table table-striped">
    <thead>
      <tr>
        <th>Category</th>
        <th>Events</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @categories.each do |category| %>
        <tr>
          <td><%= category.category_name %></td>
          <td><%= category.events.count %></td>
          <td>
            <%= link_to "Edit", edit_admin_category_path(category),
                        class: "btn btn-sm btn-outline-primary" %>
            <%= button_to "Delete", admin_category_path(category),
                          method: :delete,
                          class: "btn btn-sm btn-outline-danger",
                          form: { data: {
                            turbo_confirm: "Delete this category?"
                          } } %>
            <%= link_to "Edit", edit_admin_event_path(event),
                        class: "btn btn-sm btn-outline-primary" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
