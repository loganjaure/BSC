<section class="bsc-center">
  <h1 class="bsc-title">Edit Member</h1>

  <div class="bsc-panel">
    <p>Update the member's profile and total points below.</p>

    <% if @member.errors.any? %>
      <div role="alert" class="admin-member-errors">
        <h2>Please correct the following:</h2>
        <ul>
          <% @member.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @member, url: admin_member_path(@member), method: :patch, local: true do |form| %>
      <div>
        <%= form.label :name, "Name" %>
        <%= form.text_field :name, required: true %>
      </div>

      <div>
        <%= form.label :tamu_email, "TAMU Email" %>
        <%= form.email_field :tamu_email, required: true %>
        <p>This updates the membership email. The member continues signing in with their existing Google account.</p>
      </div>

      <div>
        <%= form.label :uin, "UIN (9 digits)" %>
        <%= form.text_field :uin, required: true, inputmode: "numeric", pattern: "[0-9]{9}", maxlength: 9 %>
      </div>

      <div>
        <%= form.label :class_year, "Class Year" %>
        <%= form.number_field :class_year, required: true, min: 2001, max: 2099, step: 1 %>
      </div>

      <div>
        <%= form.label :total_points, "Total Points" %>
        <%= form.number_field :total_points, value: @member.requested_total_points || @member.total_points, required: true, min: 0, step: "any" %>
        <p>Correcting the total preserves attendance records. Future check-ins continue adding points. Category progress still reflects attendance in each category.</p>
      </div>

      <%= form.submit "Save Changes" %>
      <%= link_to "Cancel", admin_member_path(@member) %>
    <% end %>
  </div>
</section>
