<%# AC-05.5: profile shows full name, email, class year, UIN; blank fields say "Not Provided" %>
<section class="bsc-center">
  <h1 class="bsc-title">Member Profile</h1>

  <div class="bsc-panel bsc-panel--narrow">
    <div class="bsc-row">
      <div class="bsc-label">Full name</div>
      <div><%= display_or_not_provided(@member.name) %></div>
    </div>

    <div class="bsc-row">
      <div class="bsc-label">TAMU email</div>
      <div><%= display_or_not_provided(@member.tamu_email) %></div>
    </div>

    <div class="bsc-row">
      <div class="bsc-label">UIN</div>
      <div><%= display_or_not_provided(@member.uin) %></div>
    </div>

    <div class="bsc-row">
      <div class="bsc-label">Class year</div>
      <div><%= display_or_not_provided(@member.class_year) %></div>
    </div>

    <div class="bsc-row">
      <div class="bsc-label">Role</div>
      <div><%= display_or_not_provided(@member.is_admin ? "Admin" : "Member") %></div>
    </div>

    <div class="bsc-row">
      <div class="bsc-label">Total points</div>
      <div><%= @member.total_points %></div>
    </div>
  </div>

  <div class="bsc-actions">
    <%= link_to "Edit profile", edit_member_path(@member), class: "bsc-btn" %>
    <%= button_to "Sign out", logout_path, method: :delete,
          data: { turbo: false }, class: "bsc-btn bsc-btn--ghost" %>
  </div>
</section>
