<div style="max-width: 500px; margin: 40px auto; font-family: sans-serif;">
  <h2>Complete Your Account Profile</h2>

  <%# Displays validation error messages (AC-02.3) %>
  <% if @member.errors.any? %>
    <div style="color: red; border: 1px solid red; padding: 10px; margin-bottom: 20px; border-radius: 4px;">
      <h3><%= pluralize(@member.errors.count, "error") %> prohibited this profile from being saved:</h3>
      <ul>
        <% @member.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with(model: @member, local: true) do |f| %>
    <div style="margin-bottom: 15px;">
      <%= f.label :name, "Full Name", style: "display: block; font-weight: bold;" %>
      <%= f.text_field :name, required: true, style: "width: 100%; padding: 8px;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :uin, "UIN (9 Digits)", style: "display: block; font-weight: bold;" %>
      <%= f.text_field :uin, required: true, placeholder: "e.g. 123004567", style: "width: 100%; padding: 8px;" %>
    </div>

    <div style="margin-bottom: 20px;">
      <%= f.label :class_year, "Class Year", style: "display: block; font-weight: bold;" %>
      <%= f.number_field :class_year, placeholder: "e.g. 2026", style: "width: 100%; padding: 8px;" %>
    </div>

    <div>
      <%= f.submit "Save Information", style: "background-color: #500000; color: white; padding: 10px 20px; border: none; cursor: pointer;" %>
    </div>
  <% end %>
</div>