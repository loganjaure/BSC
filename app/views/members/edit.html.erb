<section class="bsc-center">
  <h1 class="bsc-title">Complete Your Account Profile</h1>

  <div class="bsc-panel bsc-panel--narrow">
    <%# Displays validation error messages (AC-02.3) %>
    <% if @member.errors.any? %>
      <div class="bsc-errors" role="alert">
        <h3><%= pluralize(@member.errors.count, "error") %> prohibited this profile from being saved:</h3>
        <ul>
          <% @member.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with(model: @member, local: true, class: "bsc-form") do |f| %>
      <div class="bsc-field">
        <%= f.label :name, "Full Name" %>
        <%= f.text_field :name, required: true %>
      </div>

      <div class="bsc-field">
        <%= f.label :uin, "UIN (9 Digits)" %>
        <%= f.text_field :uin, required: true, placeholder: "e.g. 123004567" %>
      </div>

      <div class="bsc-field">
        <%= f.label :class_year, "Class Year" %>
        <%= f.number_field :class_year, placeholder: "e.g. 2026" %>
      </div>

      <div>
        <%= f.submit "Save Information" %>
      </div>
    <% end %>
  </div>
</section>
