<%# app/views/appeals/index.html.erb %>
<section class="bsc-center">
  <h1 class="bsc-title">My Appeals</h1>

  <div class="bsc-panel bsc-panel--narrow">
    <% if current_member&.is_admin? %>
      <p><%= link_to "Review Member Appeals", admin_appeals_path %></p>
    <% end %>

    <h2 style="font-size: 1.25rem; font-weight: bold; margin-bottom: 1rem;">Submit an Attendance Appeal</h2>

    <%# AC-11.03: Error messaging display %>
    <% if @appeal.errors.any? %>
      <div class="bsc-alert bsc-alert--danger" style="color: #b91c1c; background-color: #fef2f2; border: 1px solid #fecaca; padding: 0.75rem; border-radius: 0.375rem; margin-bottom: 1rem;">
        <p style="font-weight: bold; margin-bottom: 0.5rem;">Please fix the following error(s):</p>
        <ul style="margin-left: 1.25rem; list-style-type: disc;">
          <% @appeal.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%# AC-11.01 & AC-11.02: Submission Form %>
    <%= form_with(model: @appeal, local: true) do |f| %>
      <div style="margin-bottom: 1rem;">
        <%= f.label :event_id, "Select Missed Event", style: "display: block; font-weight: bold; margin-bottom: 0.25rem;" %>
        <%= f.collection_select :event_id, @passed_events, :id, :event_name,
            { prompt: "-- Select a passed event --" },
            { class: "bsc-input" } %>
      </div>

      <div style="margin-bottom: 1rem;">
        <%= f.label :reason, "Reason for Appeal", style: "display: block; font-weight: bold; margin-bottom: 0.25rem;" %>
        <%= f.text_area :reason, rows: 4, placeholder: "Explain why you missed this event or event check-in...", class: "bsc-input" %>
      </div>

      <div>
        <%= f.submit "Submit Appeal", class: "bsc-btn" %>
      </div>
    <% end %>
  </div>

  <%# AC-11.04: Appeals Dashboard Section %>
  <div class="bsc-panel" style="margin-top: 2rem;">
    <h2>Submitted Appeals History</h2>

    <% if @appeals.any? %>
      <% @appeals.each do |appeal| %>
        <article style="border-bottom: 1px solid #eee; padding: 1rem 0;">
          <h3 style="font-weight: bold; font-size: 1.1rem;"><%= appeal.event&.event_name %></h3>
          <p><strong>Submitted:</strong> <%= appeal.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
          <p class="appeal-reason"><strong>Reason:</strong> <%= appeal.reason %></p>
          <p><strong>Status:</strong> <span><%= appeal.status.capitalize %></span></p>
        </article>
      <% end %>
    <% else %>
      <p>You have no submitted appeals.</p>
    <% end %>
  </div>
</section>
